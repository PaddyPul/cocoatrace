# Local-only CocoaTrace demo configuration. Never use for staging or production.
APP_ENV=demo
DEMO_MODE=true
VITE_DEMO_MODE=true
DATABASE_URL=postgresql://cocoa:cocoa_dev@localhost:15433/cocoatrace
JWT_SECRET=cocoatrace_dev_secret_change_in_production
PLATFORM_FEE_BPS=100
PORT=3001
WEB_PORT=3000
WEB_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
COOKIE_SECURE=false
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
OPENAI_API_KEY=
OPENAI_MODEL=
APP_VERSION=development
