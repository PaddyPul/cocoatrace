# Local-only CocoaTrace demo configuration. Never use for staging or production.
APP_ENV=demo
DEMO_MODE=true
VITE_DEMO_MODE=true
DATABASE_URL=postgresql://cocoa:cocoa_dev@localhost:15433/cocoatrace
JWT_SECRET=cocoatrace_dev_secret_change_in_production
PLATFORM_FEE_BPS=100
PORT=3001
WEB_PORT=3000
WEB_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
COOKIE_SECURE=false
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
OPENAI_API_KEY=
OPENAI_MODEL=
APP_VERSION=development
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_LOCAL_ROOT=api/private-evidence
EVIDENCE_UPLOAD_SIGNING_SECRET=cocoatrace_demo_upload_signing_secret
EVIDENCE_MAX_FILE_BYTES=10485760
EVIDENCE_ORGANIZATION_QUOTA_BYTES=1073741824
EVIDENCE_SCANNER_DRIVER=clamav
EVIDENCE_SCANNER_HOST=localhost
EVIDENCE_SCANNER_PORT=3310
EVIDENCE_SCANNER_TIMEOUT_MS=30000
EVIDENCE_SCANNER_RETRIES=2
