# Staging template only. Replace placeholders in your hosting secret manager.
# Never commit a populated secrets file or deploy the local demo Compose stack.
# CocoaTrace environment variables
# Use 15433 on Windows to avoid conflicts with local Postgres on 5432/5433.
APP_ENV=staging
DEMO_MODE=false
VITE_DEMO_MODE=false
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_PRIVATE_DATABASE_HOST:5432/cocoatrace_staging

JWT_SECRET=REPLACE_WITH_UNIQUE_SESSION_SECRET
PLATFORM_FEE_BPS=100
PORT=3001
WEB_PORT=3000
WEB_URL=https://staging.REPLACE_DOMAIN
# Absolute browser URL encoded into product QR codes.
PUBLIC_WEB_URL=https://staging.REPLACE_DOMAIN

# Browser sessions use an HttpOnly cookie. Set true behind HTTPS in production.
COOKIE_SECURE=true
MFA_ENFORCED=true
# Managed PostgreSQL commonly requires TLS.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Optional. Without both values, the readiness assistant stays in deterministic rules mode.
OPENAI_API_KEY=
OPENAI_MODEL=
APP_VERSION=REPLACE_WITH_GIT_COMMIT

# Only for deliberate resets of an isolated remote demo database. Never set in staging/production.
COCOATRACE_ALLOW_REMOTE_DEMO_RESET=

# Private evidence storage. Production/staging must use HTTPS S3-compatible storage.
EVIDENCE_STORAGE_DRIVER=s3
EVIDENCE_STORAGE_LOCAL_ROOT=api/private-evidence
EVIDENCE_STORAGE_ENDPOINT=https://REPLACE_OBJECT_STORAGE_HOST
EVIDENCE_STORAGE_REGION=us-east-1
EVIDENCE_STORAGE_BUCKET=cocoatrace-staging-evidence
EVIDENCE_STORAGE_ACCESS_KEY=REPLACE_STAGING_STORAGE_KEY
EVIDENCE_STORAGE_SECRET_KEY=REPLACE_STAGING_STORAGE_SECRET
EVIDENCE_STORAGE_SSE=AES256
EVIDENCE_STORAGE_AUTO_CREATE_BUCKET=false
EVIDENCE_UPLOAD_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_UPLOAD_SECRET
EVIDENCE_MAX_FILE_BYTES=10485760
EVIDENCE_ORGANIZATION_QUOTA_BYTES=1073741824
EVIDENCE_SCANNER_DRIVER=clamav
EVIDENCE_SCANNER_HOST=REPLACE_PRIVATE_SCANNER_HOST
EVIDENCE_SCANNER_PORT=3310
EVIDENCE_SCANNER_TIMEOUT_MS=15000
EVIDENCE_SCANNER_RETRIES=2

# Transactional identity email. Keep disabled locally unless testing an explicit flow.
# Staging/production require authenticated SMTP with verified TLS when enabled.
IDENTITY_EMAIL_ENABLED=true
EMAIL_DRIVER=smtp
EMAIL_FROM=noreply@REPLACE_DOMAIN
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=REPLACE_STAGING_SMTP_USER
SMTP_PASSWORD=REPLACE_STAGING_SMTP_PASSWORD
SMTP_AUTH_METHOD=plain
SMTP_CONNECTION_TIMEOUT_MS=10000
