{
  "name": "cocoatrace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "install:all": "npm install",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:seed": "npm run db:seed --workspace=api",
    "demo:seed:fresh": "npm run demo:seed:fresh --workspace=api",
    "demo:seed:commercial": "npm run demo:seed:commercial --workspace=api",
    "demo:seed:incident": "npm run demo:seed:incident --workspace=api",
    "demo:reset": "npm run demo:seed:incident",
    "demo:validate": "npm run demo:validate --workspace=api",
    "dev": "node scripts/dev.js",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "check:production": "node scripts/check-production-env.js",
    "test:integration": "npm run test:integration --workspace=api",
    "test:integration:docker": "npm run test:integration:docker --workspace=api",
    "test:browser": "playwright test",
    "test:browser:docker": "node scripts/run-browser-tests.mjs",
    "typecheck:browser": "tsc --noEmit -p e2e/tsconfig.json",
    "test:migrations:docker": "node scripts/run-migration-tests.mjs",
    "test:recovery:docker": "node scripts/run-recovery-tests.mjs",
    "trade:reconcile": "tsx api/scripts/reconcile-trades.ts",
    "trust:report": "tsx api/scripts/report-trust-corrections.ts",
    "recall:check": "tsx api/scripts/reconcile-recall-safety.ts",
    "recall:deliver": "tsx api/scripts/deliver-recall-notifications.ts",
    "check:staging": "tsx api/scripts/check-staging-config.ts",
    "verify:release": "node scripts/run-release-checks.mjs",
    "demo:preview:start": "node scripts/demo-preview.mjs start",
    "demo:preview:share": "node scripts/demo-preview.mjs share",
    "demo:preview:stop": "node scripts/demo-preview.mjs stop",
    "demo:preview:status": "node scripts/demo-preview.mjs status",
    "demo:preview:check": "node scripts/demo-preview.mjs check",
    "payments:remind": "npm run payments:remind --workspace=api",
    "lint": "eslint api/src web/src e2e scripts --max-warnings=0",
    "format:check": "node scripts/run-format-check.mjs",
    "format:fix": "node scripts/run-format-check.mjs --write",
    "check:scripts": "node scripts/check-script-contracts.mjs",
    "check:quality": "npm run lint && npm run format:check && npm run check:scripts && node --test scripts/quality-policy.test.mjs scripts/check-script-contracts.test.mjs",
    "typecheck": "npm run typecheck --workspace=api && npm run typecheck --workspace=web && npm run typecheck:browser",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:containers": "node scripts/check-container-security.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "concurrently": "^8.2.2",
    "eslint": "10.12.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.71.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
