# CocoaTrace environment variables
# Use 15433 on Windows to avoid conflicts with local Postgres on 5432/5433.
APP_ENV=development
DEMO_MODE=false
VITE_DEMO_MODE=false
DATABASE_URL=postgresql://cocoa:cocoa_dev@localhost:15433/cocoatrace

JWT_SECRET=cocoatrace_dev_secret_change_in_production
PLATFORM_FEE_BPS=100
PORT=3001
WEB_PORT=3000
WEB_URL=http://localhost:3000
# Absolute browser URL encoded into product QR codes.
PUBLIC_WEB_URL=http://localhost:3000

# Browser sessions use an HttpOnly cookie. Set true behind HTTPS in production.
COOKIE_SECURE=false
# Managed PostgreSQL commonly requires TLS.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Optional. Without both values, the readiness assistant stays in deterministic rules mode.
OPENAI_API_KEY=
OPENAI_MODEL=
APP_VERSION=development

# Only for deliberate resets of an isolated remote demo database. Never set in staging/production.
COCOATRACE_ALLOW_REMOTE_DEMO_RESET=
