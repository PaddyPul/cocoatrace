# CocoaTrace environment variables
# Use 15433 on Windows to avoid conflicts with local Postgres on 5432/5433.
APP_ENV=development
DEMO_MODE=false
VITE_DEMO_MODE=false
DATABASE_URL=postgresql://cocoa:cocoa_dev@localhost:15433/cocoatrace

JWT_SECRET=cocoatrace_dev_secret_change_in_production
PLATFORM_FEE_BPS=100
PORT=3001
WEB_PORT=3000
WEB_URL=http://localhost:3000
# Absolute browser URL encoded into product QR codes.
PUBLIC_WEB_URL=http://localhost:3000

# Browser sessions use an HttpOnly cookie. Set true behind HTTPS in production.
COOKIE_SECURE=false
# Managed PostgreSQL commonly requires TLS.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Optional. Without both values, the readiness assistant stays in deterministic rules mode.
OPENAI_API_KEY=
OPENAI_MODEL=
APP_VERSION=development

# Only for deliberate resets of an isolated remote demo database. Never set in staging/production.
COCOATRACE_ALLOW_REMOTE_DEMO_RESET=

# Private evidence storage. Production/staging must use HTTPS S3-compatible storage.
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_LOCAL_ROOT=api/private-evidence
EVIDENCE_STORAGE_ENDPOINT=
EVIDENCE_STORAGE_REGION=us-east-1
EVIDENCE_STORAGE_BUCKET=
EVIDENCE_STORAGE_ACCESS_KEY=
EVIDENCE_STORAGE_SECRET_KEY=
EVIDENCE_STORAGE_SSE=
EVIDENCE_STORAGE_AUTO_CREATE_BUCKET=true
EVIDENCE_UPLOAD_SIGNING_SECRET=cocoatrace_local_evidence_signing_secret
EVIDENCE_MAX_FILE_BYTES=10485760
EVIDENCE_ORGANIZATION_QUOTA_BYTES=1073741824
EVIDENCE_SCANNER_DRIVER=development
EVIDENCE_SCANNER_HOST=
EVIDENCE_SCANNER_PORT=3310
EVIDENCE_SCANNER_TIMEOUT_MS=15000
EVIDENCE_SCANNER_RETRIES=2

# Transactional identity email. Keep disabled locally unless testing an explicit flow.
# Staging/production require authenticated SMTP with verified TLS when enabled.
IDENTITY_EMAIL_ENABLED=false
EMAIL_DRIVER=development
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH_METHOD=plain
SMTP_CONNECTION_TIMEOUT_MS=10000

# Mandatory in staging/production (cannot be disabled). Enable locally for hardware checks.
# Enrolled accounts always require passkeys even when local enforcement is false.
MFA_ENFORCED=false
