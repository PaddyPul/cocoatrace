# API-local environment. Copy to api/.env for local development if needed.
APP_ENV=development
DEMO_MODE=false
DATABASE_URL=postgresql://cocoa:cocoa_dev@localhost:15433/cocoatrace
JWT_SECRET=cocoatrace_dev_secret_change_in_production
PLATFORM_FEE_BPS=100
PORT=3001
PUBLIC_WEB_URL=http://localhost:3000
COOKIE_SECURE=false
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Optional real support/reply address; leave blank until one is operated.
EMAIL_SUPPORT_ADDRESS=
